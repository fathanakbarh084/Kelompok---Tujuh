<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="flowgorithm7"/>
        <attribute name="authors" value="mac"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-22 04:08:32 PM"/>
        <attribute name="created" value="bWFjO01BQ1MtTUFDQk9PSy1QUjsyMDI2LTA5LTIyOzEwOjU2OjAyIGFtOzI2ODc="/>
        <attribute name="edited" value="bWFjO01BQ1MtTUFDQk9PSy1QUjsyMDI2LTA5LTIyOzExOjI2OjEyIGFtOzU7Mjc5OA=="/>
        <attribute name="edited" value="dXNlcjtMQVBUT1AtTlIxRkVNUUU7MjAyNi0wOS0yMjswNDowODozMiBQTTsyOzI5MjQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, jumlahTiket, usia" type="Integer" array="False" size=""/>
            <declare name="namaPembeli, hari, kodePromo" type="String" array="False" size=""/>
            <declare name="hargaDasar, totalTiket, totalDasar, totalHarga, totalAkhir" type="Real" array="False" size=""/>
            <assign variable="totalTiket" expression="0"/>
            <assign variable="totalDasar" expression="0"/>
            <output expression="&quot;Masukkan Jumlah Tiket Yang Ingin Anda Beli :&quot;" newline="True"/>
            <input variable="jumlahTiket"/>
            <for variable="i" start="1" end="jumlahTiket" direction="inc" step="1">
                <output expression="&quot;Pemilik Tiket Ke-&quot; &amp; i &amp; &quot; :&quot;" newline="True"/>
                <output expression="&quot;Masukkan Nama Pemilik Tiket :&quot;" newline="True"/>
                <input variable="namaPembeli"/>
                <output expression="&quot;Masukkan Usia Pemilik Tiket :&quot;" newline="True"/>
                <input variable="usia"/>
                <if expression="usia &lt; 5">
                    <then>
                        <assign variable="hargaDasar" expression="0"/>
                    </then>
                    <else>
                        <if expression="usia &lt;= 12">
                            <then>
                                <assign variable="hargaDasar" expression="20000"/>
                            </then>
                            <else>
                                <if expression="usia &lt; 59">
                                    <then>
                                        <assign variable="hargaDasar" expression="50000"/>
                                    </then>
                                    <else>
                                        <if expression="usia &gt;= 60">
                                            <then>
                                                <assign variable="hargaDasar" expression="35000"/>
                                            </then>
                                            <else/>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <assign variable="totalDasar" expression="totalDasar+hargaDasar"/>
            </for>
            <output expression="&quot;Masukkan Hari Pembelian Tiket :&quot;" newline="True"/>
            <input variable="hari"/>
            <if expression="hari == &quot;sabtu&quot; or hari == &quot;minggu&quot;">
                <then>
                    <assign variable="totalAkhir" expression="totalDasar + (totalDasar * 0.20)"/>
                </then>
                <else>
                    <assign variable="totalAkhir" expression="totalDasar"/>
                </else>
            </if>
            <if expression="jumlahTiket &gt;= 5">
                <then>
                    <assign variable="totalAkhir" expression="totalAkhir - (totalAkhir * 0.10)"/>
                </then>
                <else/>
            </if>
            <output expression="&quot;Masukkan Kode Promo Pembelian Tiket :&quot;" newline="True"/>
            <input variable="kodePromo"/>
            <if expression="kodePromo == &quot;HEMAT7&quot;">
                <then>
                    <assign variable="totalAkhir" expression="totalAkhir - 10000"/>
                </then>
                <else/>
            </if>
            <output expression="&quot;Total Tiket Yang Dibeli : &quot; &amp; jumlahTiket" newline="True"/>
            <output expression="&quot;Total Biaya Pembayaran Tiket : Rp&quot; &amp; totalAkhir" newline="True"/>
        </body>
    </function>
</flowgorithm>
